# Leave empty to auto-derive the backend host from the page URL (works for
# localhost and LAN/`--host` testing). Set to a full URL to override, e.g.
# VITE_WEB_SOCKET_SERVER="http://192.168.1.50:3000"
VITE_WEB_SOCKET_SERVER=
# VITE_API_SERVER=

# WebRTC ICE servers used for peer connections.
VITE_STUN_URL="stun:stun.l.google.com:19302"
VITE_TURN_URL="turn:127.0.0.1:3478"
VITE_TURN_USERNAME="voiceuser"
VITE_TURN_CREDENTIAL="voicepass"
